# Copy to .env, fill from your accounts.
ANTHROPIC_API_KEY=
FULLENRICH_API_KEY=
# Sillage: the sk_live key authenticates the MCP directly over HTTP (no OAuth needed)
SILLAGE_API_KEY=
# Unipile (send): DSN + token from dashboard. LOCAL ONLY — do not put on Vercel.
UNIPILE_DSN=
UNIPILE_API_KEY=
# Slack delivery — PREFER the Web API bot token (per-rep channels/DMs/threads):
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# ...or a single-channel incoming webhook (fallback only):
SLACK_WEBHOOK_URL=
# Public app URL used in Slack "Review & send" buttons
LITMUS_APP_URL=https://litmus-roan.vercel.app
# HubSpot (stretch): private-app token in a dev test account
HUBSPOT_TOKEN=
# Scoring model. Sonnet for cost; Fable for latency.
LITMUS_MODEL=claude-sonnet-5
