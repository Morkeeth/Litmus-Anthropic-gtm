# Copy to .env at kickoff, fill from the keys handed out at 9:00
ANTHROPIC_API_KEY=
FULLENRICH_API_KEY=
# Sillage: no API key — connect via `claude mcp add --transport http sillage https://api.getsillage.com/api/mcp/v2` (OAuth)
# Unipile: DSN + token from dashboard (7-day free trial)
UNIPILE_DSN=
UNIPILE_API_KEY=
# Output sink (demo): Slack incoming webhook
SLACK_WEBHOOK_URL=
# HubSpot (stretch): private-app token in a dev test account
HUBSPOT_TOKEN=
# Model for the scoring loop. Fable for latency; fall back to a Sonnet id if quality dips.
LITMUS_MODEL=claude-fable-5
